# Database
DATABASE_URL="postgresql://kaana:kaana_dev@localhost:5433/kaana_foods?schema=public"

# Redis
REDIS_URL="redis://localhost:6380"

# MinIO / S3
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="kaana_minio"
S3_SECRET_KEY="kaana_minio_dev"
S3_BUCKET="kaana-foods"

# Auth
JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_REFRESH_SECRET="change-me-refresh-secret-long-random"
JWT_EXPIRES_IN="15m"
JWT_OPERATIONAL_EXPIRES_IN="8h"
JWT_REFRESH_EXPIRES_IN="7d"

# API
API_PORT=4000
API_URL="http://localhost:4000"
# Comma-separated extra browser origins (Cloud Run URLs). Localhost origins are always allowed.
CORS_ORIGINS=""

# Web apps (NEXT_PUBLIC_* is baked in at next build)
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_WS_URL="http://localhost:4000/events"
NEXT_PUBLIC_HUB_URL="http://localhost:4100"
NEXT_PUBLIC_OPERATIONS_WEB_URL="http://localhost:3010"
NEXT_PUBLIC_POS_WEB_URL="http://localhost:3001"
NEXT_PUBLIC_KDS_WEB_URL="http://localhost:3002"
NEXT_PUBLIC_CAPTAIN_WEB_URL="http://localhost:3003"

# Razorpay (Phase 8)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Aggregators (Phase 5)
ZOMATO_API_KEY=""
SWIGGY_API_KEY=""
