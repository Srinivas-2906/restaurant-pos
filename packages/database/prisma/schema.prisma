  loanType       String
  principal      Decimal    @db.Decimal(12, 2)
  interestRate   Decimal    @default(0) @db.Decimal(6, 4)
  emiAmount      Decimal    @db.Decimal(12, 2)
  outstanding    Decimal    @db.Decimal(12, 2)
  startDate      DateTime   @db.Date
  endDate        DateTime?  @db.Date
  status         LoanStatus @default(active)
  createdAt      DateTime   @default(now())
  staff          StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  installments   LoanInstallment[]
  @@index([staffProfileId, status])
}

model LoanInstallment {
  id           String    @id @default(cuid())
  loanId       String
  dueDate      DateTime  @db.Date
  amount       Decimal   @db.Decimal(12, 2)
  paidAmount   Decimal   @default(0) @db.Decimal(12, 2)
  paidAt       DateTime?
  payrollRunId String?
  loan         EmployeeLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

model SalaryAdvance {
  id             String   @id @default(cuid())
  staffProfileId String
  amount         Decimal  @db.Decimal(12, 2)
  recovered      Decimal  @default(0) @db.Decimal(12, 2)
  reason         String?
  status         String   @default("open")
  createdAt      DateTime @default(now())
  staff          StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
}

model FinalSettlement {
  id             String           @id @default(cuid())
  staffProfileId String
  lastWorkingDay DateTime         @db.Date
  status         SettlementStatus @default(initiated)
  grossAmount    Decimal          @default(0) @db.Decimal(14, 2)
  deductions     Decimal          @default(0) @db.Decimal(14, 2)
  netAmount      Decimal          @default(0) @db.Decimal(14, 2)
  breakdown      Json             @default("{}")
  approvedById   String?
  paidAt         DateTime?
  createdAt      DateTime         @default(now())
  staff          StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
}

model ComplianceJurisdiction {
  id             String   @id @default(cuid())
  organizationId String
  stateCode      String
  stateName      String
  rulePack       Json     @default("{}")
  effectiveFrom  DateTime @default(now())
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  registrations  ComplianceRegistration[]
  rules          ComplianceRule[]
  @@unique([organizationId, stateCode, effectiveFrom])
}

model ComplianceRegistration {
  id             String                     @id @default(cuid())
  jurisdictionId String
  outletId       String?
  type           ComplianceRegistrationType
  registrationNo String
  issuedAt       DateTime?                  @db.Date
  expiresAt      DateTime?                  @db.Date
  metadata       Json                       @default("{}")
  createdAt      DateTime                   @default(now())
  jurisdiction   ComplianceJurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  outlet         Outlet? @relation(fields: [outletId], references: [id], onDelete: SetNull)
}

model ComplianceRule {
  id             String    @id @default(cuid())
  jurisdictionId String
  code           String
  title          String
  frequency      String
  dueDayOfMonth  Int?
  dueMonth       Int?
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  config         Json      @default("{}")
  jurisdiction   ComplianceJurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  tasks          ComplianceTask[]
  @@index([jurisdictionId, code])
}

model ComplianceTask {
  id          String    @id @default(cuid())
  ruleId      String
  outletId    String?
  dueDate     DateTime
  status      String    @default("pending")
  completedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  rule        ComplianceRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
}

model PFEnrollment {
  id               String    @id @default(cuid())
  staffProfileId   String    @unique
  uan              String?
  pfJoinDate       DateTime? @db.Date
  pfExitDate       DateTime? @db.Date
  epsApplicable    Boolean   @default(true)
  voluntaryPf      Decimal?  @db.Decimal(6, 4)
  kycStatus        String    @default("pending")
  nominationStatus String    @default("pending")
  createdAt        DateTime  @default(now())
  staff            StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
}

model ESIEnrollment {
  id              String    @id @default(cuid())
  staffProfileId  String    @unique
  insuranceNumber String?
  dispensary      String?
  coverageFrom    DateTime? @db.Date
  coverageTo      DateTime? @db.Date
  dependents      Json      @default("[]")
  createdAt       DateTime  @default(now())
  staff           StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
}

model GratuityRecord {
  id                String   @id @default(cuid())
  staffProfileId    String   @unique
  serviceStartDate  DateTime @db.Date
  eligibleYears     Decimal  @default(0) @db.Decimal(6, 2)
  lastStatutoryWage Decimal  @default(0) @db.Decimal(12, 2)
  accruedProvision  Decimal  @default(0) @db.Decimal(14, 2)
  nomineeName       String?
  updatedAt         DateTime @updatedAt
  staff             StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
}

model Contractor {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  gstin          String?
  pfCode         String?
  esicCode       String?
  contactPhone   String?
  status         ContractorStatus @default(active)
  createdAt      DateTime         @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agreements     ContractAgreement[]
}

model ContractAgreement {
  id               String    @id @default(cuid())
  contractorId     String
  outletId         String?
  startDate        DateTime  @db.Date
  endDate          DateTime? @db.Date
  licenceNo        String?
  workerCount      Int       @default(0)
  complianceExpiry DateTime? @db.Date
  createdAt        DateTime  @default(now())
  contractor       Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  workers          ContractWorker[]
}

model ContractWorker {
  id                   String   @id @default(cuid())
  agreementId          String
  name                 String
  idProof              String?
  deploymentOutletId   String?
  createdAt            DateTime @default(now())
  agreement            ContractAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
}

model TipPool {
  id           String        @id @default(cuid())
  outletId     String
  poolDate     DateTime      @db.Date
  source       String
  amount       Decimal       @db.Decimal(12, 2)
  formula      Json          @default("{}")
  status       TipPoolStatus @default(draft)
  approvedById String?
  createdAt    DateTime      @default(now())
  distributions TipDistribution[]
}

model TipDistribution {
  id             String  @id @default(cuid())
  tipPoolId      String
  staffProfileId String
  shareAmount    Decimal @db.Decimal(12, 2)
  approved       Boolean @default(false)
  tipPool        TipPool      @relation(fields: [tipPoolId], references: [id], onDelete: Cascade)
  staff          StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
}

model EmployeeAsset {
  id             String    @id @default(cuid())
  staffProfileId String
  assetType      String
  description    String?
  issuedAt       DateTime  @default(now())
  returnedAt     DateTime?
  value          Decimal?  @db.Decimal(12, 2)
  staff          StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
}

model GrievanceCase {
  id              String                   @id @default(cuid())
  organizationId  String
  staffProfileId  String?
  outletId        String?
  grievanceType   String
  summary         String
  status          GrievanceStatus          @default(open)
  confidentiality GrievanceConfidentiality @default(standard)
  isAnonymous     Boolean                  @default(false)
  assignedToId    String?
  resolution      String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  staff           StaffProfile? @relation(fields: [staffProfileId], references: [id], onDelete: SetNull)
}

model POSHCommittee {
  id               String   @id @default(cuid())
  organizationId   String
  outletId         String?
  constitutedAt    DateTime @db.Date
  presidingOfficer String
  externalMember   String?
  createdAt        DateTime @default(now())
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members          POSHCommitteeMember[]
}

model POSHCommitteeMember {
  id          String    @id @default(cuid())
  committeeId String
  name        String
  role        String
  tenureEnd   DateTime? @db.Date
  committee   POSHCommittee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
}
