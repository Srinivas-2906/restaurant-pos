generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum OutletType {
  dine_in
  cloud_kitchen
  central_kitchen
  franchise
}

enum UserRole {
  super_admin
  owner
  manager
  biller
  captain
  chef
  inventory_manager
  accountant
}

enum TableStatus {
  free
  seated
  bill_requested
  billed
  blocked
  reserved
  cleaning
}

enum OrderSource {
  dine_in
  pos
  captain
  qr
  swiggy
  zomato
  ondc
  website
  phone
  walk_in
}

enum FulfilmentType {
  restaurant
  aggregator
  customer_pickup
}

enum OrderStatus {
  draft
  open
  kot_fired
  preparing
  ready
  served
  billed
  settled
  cancelled
  voided
}

enum OrderType {
  dine_in
  takeaway
  delivery
}

enum KOTStatus {
  pending
  preparing
  ready
  served
  cancelled
}

enum PaymentMethod {
  cash
  upi
  card
  wallet
  split
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum TaxType {
  cgst_sgst
  igst
  exempt
}

enum ReservationStatus {
  pending
  confirmed
  arrived
  seated
  completed
  cancelled
  no_show
}

enum ReservationSource {
  walk_in
  phone
  website
  whatsapp
  zomato_dining
  eazydiner
  district
}

enum WaitlistStatus {
  waiting
  notified
  seated
  cancelled
}

enum POStatus {
  draft
  pending_approval
  sent
  partial
  received
  cancelled
}

enum TransferStatus {
  requested
  approved
  packed
  dispatched
  in_transit
  delivered
  received
  variance_resolved
  cancelled
}

enum StockMovementType {
  opening_stock
  purchase
  purchase_return
  recipe_consumption
  sale
  committed_out
  commit_release
  wastage
  transfer_in
  transfer_out
  production_consumption
  production_output
  stock_count_adjustment
  adjustment
  return
  expiry_writeoff
  supplier_free
  staff_meal
  complimentary
  sample
}

enum ItemType {
  raw_ingredient
  semi_prepared
  finished_stock
  packaging
  operating_supply
  beverage
}

enum UnitDimension {
  weight
  volume
  count
  length
  custom_package
}

enum NegativeStockPolicy {
  block
  warn
  allow
}

enum BatchStatus {
  available
  expiring
  expired
  quarantined
  fully_consumed
}

enum CommitmentStatus {
  committed
  consumed
  released
  wastage
}

enum CountType {
  opening
  closing
  full
  category
  location
  cycle
  surprise_audit
}

enum CountStatus {
  draft
  in_progress
  pending_approval
  approved
  posted
  cancelled
}

enum WastageCategory {
  spoilage
  expired
  kitchen_loss
  burnt
  customer_return
  spillage
  breakage
  quality_rejection
  staff_error
  trial_sample
  unexplained
}

enum ProductionStatus {
  planned
  in_progress
  completed
  cancelled
}

enum AlertType {
  below_reorder
  stock_out
  negative_stock
  expiring_soon
  expired_available
  unusual_wastage
  count_variance
  price_increase
  po_delayed
  transfer_pending
  recipe_missing
  menu_unavailable
  unapproved_adjustment
  dead_stock
}

enum PORequestStatus {
  draft
  pending_approval
  approved
  rejected
  converted
  cancelled
}

enum IntegrationType {
  zomato
  swiggy
  razorpay
  paytm
  mock_aggregator
}

enum SyncEventStatus {
  pending
  synced
  failed
  conflict
}

enum AuditAction {
  order_void
  discount_applied
  bill_modified
  drawer_opened
  stock_adjusted
  login
  logout
  kot_fired
  kot_ready
  kot_preparing
  item_served
}

// ─── Organization & Tenancy ──────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  gstin     String?
  address   String?
  city      String?
  state     String?
  pincode   String?
  phone     String?
  email     String?
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brands           Brand[]
  users            User[]
  roleAssignments  RoleAssignment[]
  auditLogs        AuditLog[]
  payrollRuns          PayrollRun[]
  departments          Department[]
  designations         Designation[]
  staffProfiles        StaffProfile[]
  staffRoleAssignments StaffRoleAssignment[]
  complianceJurisdictions ComplianceJurisdiction[]
  salaryStructures     SalaryStructure[]
  salaryComponents     SalaryComponent[]
  contractors          Contractor[]
  poshCommittees       POSHCommittee[]
  shiftTemplates       ShiftTemplate[]
}

model Brand {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  logoUrl        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outlets      Outlet[]
  menus        Menu[]

  @@unique([organizationId, slug])
}

model Outlet {
  id             String     @id @default(cuid())
  brandId        String
  name           String
  code           String
  type           OutletType @default(dine_in)
  address        String?
  city           String?
  state          String?
  pincode        String?
  phone          String?
  gstin          String?
  fssai          String?
  latitude       Float?
  longitude      Float?
  zone           String?
  isActive       Boolean    @default(true)
  settings       Json       @default("{}")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  brand                Brand                  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  terminals            Terminal[]
  kitchenStations      KitchenStation[]
  floorPlans           FloorPlan[]
  menuOverrides        OutletMenuOverride[]
  orders               Order[]
  customers            Customer[]
  reservations         Reservation[]
  waitlistEntries      WaitlistEntry[]
  ingredients          Ingredient[]
  stockLedgers         StockLedger[]
  stockLocations       StockLocation[]
  inventoryBalances    InventoryBalance[]
  stockCommitments     StockCommitment[]
  inventoryBatches     InventoryBatch[]
  goodsReceipts        GoodsReceipt[]
  purchaseRequests     PurchaseRequest[]
  purchaseInvoices     PurchaseInvoice[]
  purchaseReturns      PurchaseReturn[]
  stockCounts          StockCount[]
  wastageEntries       WastageEntry[]
  productionOrders     ProductionOrder[]
  inventoryAlerts      InventoryAlert[]
  purchaseOrders       PurchaseOrder[]
  suppliers            Supplier[]
  ckTransfersFrom      CentralKitchenTransfer[] @relation("TransferFrom")
  ckTransfersTo        CentralKitchenTransfer[] @relation("TransferTo")
  integrationCreds     IntegrationCredential[]
  syncEvents           SyncEvent[]
  roleAssignments      RoleAssignment[]
  invoiceSequences     InvoiceSequence[]
  deviceHealth         DeviceHealth[]
  orderMarginSnapshots OrderMarginSnapshot[]
  recommendations      Recommendation[]
  supportTickets       SupportTicket[]
  webhookSubscriptions WebhookSubscription[]
  apiKeys              ApiKey[]
  franchiseAudits      FranchiseAudit[]
  staffProfiles        StaffProfile[]
  shiftSchedules       ShiftSchedule[]
  attendanceRecords    AttendanceRecord[]
  wageRules            WageRule[]
  payrollRuns          PayrollRun[]
  ingredientCategories IngredientCategory[]
  stockClosings        StockClosing[]
  leaveRequests        LeaveRequest[]
  holidays             Holiday[]
  shiftTemplates       ShiftTemplate[]
  complianceRegistrations ComplianceRegistration[]
  employeeOutletAssignments EmployeeOutletAssignment[]
  staffRoleAssignments      StaffRoleAssignment[]

  @@unique([brandId, code])
}

// ─── Users & RBAC ────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  phone          String?
  passwordHash   String
  firstName      String
  lastName       String?
  avatarUrl      String?
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roleAssignments RoleAssignment[]
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]
  ordersCreated   Order[]          @relation("OrderCreatedBy")
  syncEvents          SyncEvent[]
  staffProfile        StaffProfile?
  terminalsRegistered Terminal[]     @relation("TerminalRegisteredBy")
  pinsUpdated         StaffProfile[] @relation("PinUpdatedBy")

  @@unique([organizationId, email])
}

model RoleAssignment {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  outletId       String?
  terminalId     String?
  role           UserRole
  permissions    Json     @default("[]")
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outlet       Outlet?      @relation(fields: [outletId], references: [id], onDelete: Cascade)
  terminal     Terminal?    @relation(fields: [terminalId], references: [id], onDelete: SetNull)

  @@index([userId, outletId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Terminals & Kitchen ─────────────────────────────────────────────────────

enum TerminalDeviceType {
  pos
  kds
  captain
}

model Terminal {
  id                 String             @id @default(cuid())
  outletId           String
  name               String
  code               String
  deviceType         TerminalDeviceType @default(pos)
  isMaster           Boolean            @default(false)
  isActive           Boolean            @default(true)
  isRegistered       Boolean            @default(false)
  deviceSecretHash   String?
  registeredAt       DateTime?
  registeredByUserId String?
  settings           Json               @default("{}")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  outlet               Outlet                @relation(fields: [outletId], references: [id], onDelete: Cascade)
  registeredBy         User?                 @relation("TerminalRegisteredBy", fields: [registeredByUserId], references: [id], onDelete: SetNull)
  roleAssignments      RoleAssignment[]
  staffRoleAssignments StaffRoleAssignment[]
  orders               Order[]

  @@unique([outletId, code])
}

model KitchenStation {
  id        String   @id @default(cuid())
  outletId  String
  name      String
  code      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet    Outlet     @relation(fields: [outletId], references: [id], onDelete: Cascade)
  menuItems MenuItem[]
  kots      KOT[]

  @@unique([outletId, code])
}

model FloorPlan {
  id        String   @id @default(cuid())
  outletId  String
  name      String
  isDefault Boolean  @default(false)
  layout    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet Outlet  @relation(fields: [outletId], references: [id], onDelete: Cascade)
  tables Table[]
}

model Table {
  id          String      @id @default(cuid())
  floorPlanId String
  number      String
  name        String?
  capacity    Int         @default(4)
  status      TableStatus @default(free)
  posX        Float       @default(0)
  posY        Float       @default(0)
  shape       String      @default("square")
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  floorPlan    FloorPlan     @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  orders       Order[]
  reservations Reservation[]

  @@unique([floorPlanId, number])
}

// ─── Menu & Catalog ──────────────────────────────────────────────────────────

model Menu {
  id        String   @id @default(cuid())
  brandId   String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand      Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  categories Category[]
}

model Category {
  id        String   @id @default(cuid())
  menuId    String
  name      String
  nameHi    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menu  Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  items MenuItem[]
}

model MenuItem {
  id               String   @id @default(cuid())
  categoryId       String
  kitchenStationId String?
  name             String
  nameHi           String?
  description      String?
  sku              String?
  hsnCode          String?
  basePrice        Decimal  @db.Decimal(10, 2)
  costPrice        Decimal? @db.Decimal(10, 2)
  taxRuleId        String?
  isVeg            Boolean  @default(true)
  isActive         Boolean  @default(true)
  imageUrl         String?
  prepTimeMins     Int?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category       Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  kitchenStation KitchenStation?   @relation(fields: [kitchenStationId], references: [id], onDelete: SetNull)
  taxRule        TaxRule?          @relation(fields: [taxRuleId], references: [id], onDelete: SetNull)
  variants       Variant[]
  addonGroups    MenuItemAddon[]
  overrides      OutletMenuOverride[]
  orderItems     OrderItem[]
  recipe         Recipe?
}

model Variant {
  id         String  @id @default(cuid())
  menuItemId String
  name       String
  priceDelta Decimal @default(0) @db.Decimal(10, 2)
  isDefault  Boolean @default(false)
  isActive   Boolean @default(true)
  sortOrder  Int     @default(0)

  menuItem   MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
}

model AddonGroup {
  id            String  @id @default(cuid())
  name          String
  minSelection  Int     @default(0)
  maxSelection  Int     @default(1)
  isRequired    Boolean @default(false)

  addons    Addon[]
  menuItems MenuItemAddon[]
}

model Addon {
  id           String  @id @default(cuid())
  addonGroupId String
  name         String
  price        Decimal @default(0) @db.Decimal(10, 2)
  isActive     Boolean @default(true)
  sortOrder    Int     @default(0)

  addonGroup AddonGroup @relation(fields: [addonGroupId], references: [id], onDelete: Cascade)
}

model MenuItemAddon {
  menuItemId   String
  addonGroupId String

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  addonGroup AddonGroup @relation(fields: [addonGroupId], references: [id], onDelete: Cascade)

  @@id([menuItemId, addonGroupId])
}

model TaxRule {
  id        String  @id @default(cuid())
  name      String
  type      TaxType @default(cgst_sgst)
  cgstRate  Decimal @default(0) @db.Decimal(5, 2)
  sgstRate  Decimal @default(0) @db.Decimal(5, 2)
  igstRate  Decimal @default(0) @db.Decimal(5, 2)
  isActive  Boolean @default(true)

  menuItems MenuItem[]
}

model OutletMenuOverride {
  id          String   @id @default(cuid())
  outletId    String
  menuItemId  String
  price       Decimal? @db.Decimal(10, 2)
  isAvailable Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  outlet   Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([outletId, menuItemId])
}

// ─── Orders & Billing ────────────────────────────────────────────────────────

model Order {
  id              String      @id @default(cuid())
  outletId        String
  terminalId      String?
  tableId         String?
  customerId      String?
  reservationId   String?     @unique
  createdById     String?
  orderNumber     String
  source          OrderSource @default(dine_in)
  type            OrderType   @default(dine_in)
  fulfilment      FulfilmentType?
  status          OrderStatus @default(draft)
  guestCount      Int         @default(1)
  subtotal        Decimal     @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal     @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal     @default(0) @db.Decimal(12, 2)
  notes           String?
  externalOrderId String?
  aggregatorData  Json?
  loyaltyPointsUsed Int       @default(0)
  billRequestedAt DateTime?
  billRequestedByUserId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  settledAt       DateTime?

  outlet    Outlet     @relation(fields: [outletId], references: [id], onDelete: Cascade)
  terminal  Terminal?  @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  table       Table?       @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items     OrderItem[]
  kots      KOT[]
  payments  Payment[]
  invoice   Invoice?
  marginSnapshot OrderMarginSnapshot?

  @@unique([outletId, orderNumber])
  @@index([outletId, status])
  @@index([outletId, createdAt])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  menuItemId String
  variantId  String?
  name       String
  quantity   Int     @default(1)
  unitPrice  Decimal @db.Decimal(10, 2)
  taxAmount  Decimal @default(0) @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)
  notes      String?
  addons     Json    @default("[]")
  status     String  @default("pending")
  kotId      String?

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem  @relation(fields: [menuItemId], references: [id])
  variant  Variant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  kot      KOT?      @relation(fields: [kotId], references: [id], onDelete: SetNull)
  kotItems KOTItem[]
}

model KOT {
  id               String    @id @default(cuid())
  orderId          String
  kitchenStationId String
  kotNumber        String
  status           KOTStatus @default(pending)
  firedAt          DateTime  @default(now())
  readyAt          DateTime?
  notes            String?

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kitchenStation KitchenStation @relation(fields: [kitchenStationId], references: [id])
  items          KOTItem[]
  orderItems     OrderItem[]

  @@index([kitchenStationId, status])
}

model KOTItem {
  id          String @id @default(cuid())
  kotId       String
  orderItemId String
  quantity    Int
  status      KOTStatus @default(pending)

  kot       KOT       @relation(fields: [kotId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  method        PaymentMethod
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(pending)
  reference     String?
  gatewayData   Json?
  processedAt   DateTime?
  createdAt     DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String   @id @default(cuid())
  orderId       String   @unique
  invoiceNumber String
  gstin         String?
  cgstAmount    Decimal  @default(0) @db.Decimal(12, 2)
  sgstAmount    Decimal  @default(0) @db.Decimal(12, 2)
  igstAmount    Decimal  @default(0) @db.Decimal(12, 2)
  taxableAmount Decimal  @db.Decimal(12, 2)
  totalAmount   Decimal  @db.Decimal(12, 2)
  pdfUrl        String?
  issuedAt      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model InvoiceSequence {
  id        String @id @default(cuid())
  outletId  String
  prefix    String @default("INV")
  year      Int
  lastNumber Int   @default(0)

  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([outletId, year])
}

// ─── CRM & Loyalty ───────────────────────────────────────────────────────────

model Customer {
  id           String   @id @default(cuid())
  outletId     String
  phone        String
  name         String?
  email        String?
  tags         String[] @default([])
  notes        String?
  totalOrders  Int      @default(0)
  totalSpent   Decimal  @default(0) @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  outlet          Outlet          @relation(fields: [outletId], references: [id], onDelete: Cascade)
  orders          Order[]
  loyaltyAccount  LoyaltyAccount?
  reservations    Reservation[]

  @@unique([outletId, phone])
}

model LoyaltyAccount {
  id         String   @id @default(cuid())
  customerId String   @unique
  points     Int      @default(0)
  tier       String   @default("bronze")
  updatedAt  DateTime @updatedAt

  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  history  LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id               String   @id @default(cuid())
  loyaltyAccountId String
  points           Int
  type             String
  description      String?
  orderId          String?
  createdAt        DateTime @default(now())

  loyaltyAccount LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
}

// ─── Reservations ────────────────────────────────────────────────────────────

model Reservation {
  id              String            @id @default(cuid())
  outletId        String
  customerId      String?
  tableId         String?
  guestName       String
  guestPhone      String
  guestCount      Int
  date            DateTime
  status          ReservationStatus @default(pending)
  source          ReservationSource @default(walk_in)
  notes           String?
  occasion        String?
  specialRequest  String?
  preferredArea   String?
  advancePayment  Decimal?          @db.Decimal(10, 2)
  arrivedAt       DateTime?
  seatedAt        DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  outlet          Outlet           @relation(fields: [outletId], references: [id], onDelete: Cascade)
  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  table           Table?           @relation(fields: [tableId], references: [id], onDelete: SetNull)
  order           Order?
  waitlistEntries WaitlistEntry[]

  @@index([outletId, date])
  @@index([outletId, status])
}

model WaitlistEntry {
  id             String         @id @default(cuid())
  outletId       String
  guestName      String
  guestPhone     String
  guestCount     Int
  quotedWaitMins Int?
  notes          String?
  status         WaitlistStatus @default(waiting)
  position       Int            @default(0)
  reservationId  String?
  notifiedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  outlet      Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([outletId, status, position])
}

// ─── Inventory ────────────────────────────────────────────────────────────────

model IngredientCategory {
  id        String   @id @default(cuid())
  outletId  String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  outlet      Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  ingredients Ingredient[]

  @@unique([outletId, name])
}

model Ingredient {
  id               String   @id @default(cuid())
  outletId         String
  name             String
  unit             String
  consumptionUnit  String?
  currentStock     Decimal  @default(0) @db.Decimal(12, 3)
  minStock         Decimal  @default(0) @db.Decimal(12, 3)
  parStock         Decimal  @default(0) @db.Decimal(12, 3)
  costPerUnit      Decimal  @default(0) @db.Decimal(10, 2)
  taxPct           Decimal  @default(0) @db.Decimal(5, 2)
  normalLossPct    Decimal  @default(0) @db.Decimal(5, 2)
  allowDecimal     Boolean  @default(true)
  isFavourite      Boolean  @default(false)
  categoryId       String?
  supplierId       String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Item master extensions
  itemType                 ItemType            @default(raw_ingredient)
  sku                      String?
  barcode                  String?
  brand                    String?
  description              String?
  imageUrl                 String?
  purchaseUnit             String?
  purchaseToStockFactor    Decimal?            @db.Decimal(12, 6)
  stockToConsumptionFactor Decimal?            @db.Decimal(12, 6)
  reorderLevel             Decimal             @default(0) @db.Decimal(12, 3)
  targetStock              Decimal             @default(0) @db.Decimal(12, 3)
  maxStock                 Decimal             @default(0) @db.Decimal(12, 3)
  safetyStock              Decimal             @default(0) @db.Decimal(12, 3)
  leadTimeDays             Int                 @default(0)
  reorderQuantity          Decimal             @default(0) @db.Decimal(12, 3)
  negativeStockPolicy      NegativeStockPolicy @default(warn)
  lastPurchaseCost         Decimal             @default(0) @db.Decimal(10, 2)
  weightedAverageCost      Decimal             @default(0) @db.Decimal(10, 2)
  standardCost             Decimal?            @db.Decimal(10, 2)
  previousPurchaseCost     Decimal             @default(0) @db.Decimal(10, 2)
  costChangePct            Decimal             @default(0) @db.Decimal(5, 2)
  storageLocation          String?
  isPerishable             Boolean             @default(false)
  defaultShelfLifeDays     Int?
  trackExpiry              Boolean             @default(false)
  trackBatch               Boolean             @default(false)
  minRemainingShelfLifeDays Int?
  storageInstructions      String?
  hsnCode                  String?
  minOrderQuantity         Decimal             @default(0) @db.Decimal(12, 3)
  yieldPct                 Decimal             @default(100) @db.Decimal(5, 2)
  notes                    String?
  committedStock           Decimal             @default(0) @db.Decimal(12, 3)

  outlet       Outlet              @relation(fields: [outletId], references: [id], onDelete: Cascade)
  category     IngredientCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplier     Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  recipeItems  RecipeItem[]
  stockLedgers StockLedger[]
  poItems      POItem[]
  conversions  ItemUnitConversion[]
  balances     InventoryBalance[]
  commitments  StockCommitment[]
  batches      InventoryBatch[]
  supplierItems SupplierItem[]
  goodsReceiptLines GoodsReceiptLine[]
  stockCountLines   StockCountLine[]
  wastageEntries    WastageEntry[]
  productionOrders  ProductionOrder[] @relation("ProductionOutput")
  productionInputs  ProductionInput[]
  transferLines     StockTransferLine[]
  purchaseReturnLines PurchaseReturnLine[]
  alerts            InventoryAlert[]
}

model StockClosing {
  id          String             @id @default(cuid())
  outletId    String
  date        DateTime           @db.Date
  status      StockClosingStatus @default(pending)
  accuracyPct Decimal?           @db.Decimal(5, 2)
  closedById  String?
  closedAt    DateTime?
  notes       String?
  createdAt   DateTime           @default(now())

  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([outletId, date])
  @@index([outletId, date])
}

model Recipe {
  id         String @id @default(cuid())
  menuItemId String @unique
  yieldQty   Int    @default(1)
  stages     Json   @default("[]")
  instructions String?
  version    Int    @default(1)
  isActive   Boolean @default(true)
  effectiveFrom DateTime @default(now())

  menuItem MenuItem        @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  items    RecipeItem[]
  versions RecipeVersion[]
}

model RecipeItem {
  id           String  @id @default(cuid())
  recipeId     String
  ingredientId String
  quantity     Decimal @db.Decimal(12, 3)
  stage        Int     @default(1)
  lossPct      Decimal @default(0) @db.Decimal(5, 2)
  isOptional   Boolean @default(false)
  consumptionUnit String?
  subRecipeId  String?

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
}

model StockLedger {
  id           String            @id @default(cuid())
  outletId     String
  ingredientId String
  type         StockMovementType
  quantity     Decimal           @db.Decimal(12, 3)
  balanceAfter Decimal           @db.Decimal(12, 3)
  reference    String?
  notes        String?
  createdById  String?
  createdAt    DateTime          @default(now())
  batchId      String?
  unitCost     Decimal?          @db.Decimal(10, 2)
  totalValue   Decimal?          @db.Decimal(12, 2)
  sourceLocationId String?
  destLocationId   String?
  reversalOfId     String?
  reason           String?
  approvalStatus   String?

  outlet     Outlet     @relation(fields: [outletId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  batch      InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([outletId, ingredientId])
  @@index([outletId, createdAt])
}

model Supplier {
  id        String   @id @default(cuid())
  outletId  String
  name      String
  phone     String?
  email     String?
  address   String?
  gstin     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  contactPerson    String?
  whatsapp         String?
  pan              String?
  fssaiLicense     String?
  paymentTerms     String?
  creditDays       Int      @default(0)
  creditLimit      Decimal  @default(0) @db.Decimal(12, 2)
  minOrderValue    Decimal  @default(0) @db.Decimal(12, 2)
  deliveryDays     String?
  deliveryLeadTime Int      @default(0)
  bankInfo         String?
  openingBalance   Decimal  @default(0) @db.Decimal(12, 2)
  onTimeDeliveryPct Decimal @default(0) @db.Decimal(5, 2)
  rejectionRate    Decimal  @default(0) @db.Decimal(5, 2)
  avgPriceVariance Decimal  @default(0) @db.Decimal(5, 2)
  outstandingAmount Decimal @default(0) @db.Decimal(12, 2)
  lastPurchaseAt   DateTime?
  totalPurchases   Decimal  @default(0) @db.Decimal(12, 2)

  outlet       Outlet          @relation(fields: [outletId], references: [id], onDelete: Cascade)
  ingredients  Ingredient[]
  purchaseOrders PurchaseOrder[]
  supplierItems SupplierItem[]
  goodsReceipts GoodsReceipt[]
  purchaseInvoices PurchaseInvoice[]
  purchaseReturns PurchaseReturn[]
  batches      InventoryBatch[]
}

model PurchaseOrder {
  id         String   @id @default(cuid())
  outletId   String
  supplierId String
  poNumber   String
  status     POStatus @default(draft)
  totalAmount Decimal @default(0) @db.Decimal(12, 2)
  notes      String?
  orderedAt  DateTime?
  receivedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  outlet   Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id])
  items    POItem[]
  goodsReceipts GoodsReceipt[]

  @@unique([outletId, poNumber])
}

model POItem {
  id            String  @id @default(cuid())
  purchaseOrderId String
  ingredientId  String
  quantity      Decimal @db.Decimal(12, 3)
  receivedQty   Decimal @default(0) @db.Decimal(12, 3)
  unitPrice     Decimal @db.Decimal(10, 2)
  totalPrice    Decimal @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredient    Ingredient    @relation(fields: [ingredientId], references: [id])
}

model CentralKitchenTransfer {
  id             String         @id @default(cuid())
  fromOutletId   String
  toOutletId     String
  transferNumber String
  status         TransferStatus @default(requested)
  items          Json           @default("[]")
  notes          String?
  requestedAt    DateTime       @default(now())
  deliveredAt    DateTime?
  requestedById  String?
  approvedById   String?
  dispatchedAt   DateTime?
  receivedAt     DateTime?
  deliveryPerson String?
  vehicleInfo    String?

  fromOutlet Outlet @relation("TransferFrom", fields: [fromOutletId], references: [id])
  toOutlet   Outlet @relation("TransferTo", fields: [toOutletId], references: [id])
  lines      StockTransferLine[]

  @@unique([fromOutletId, transferNumber])
}

model ItemUnitConversion {
  id           String        @id @default(cuid())
  ingredientId String
  fromUnit     String
  toUnit       String
  factor       Decimal       @db.Decimal(12, 6)
  dimension    UnitDimension

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, fromUnit, toUnit])
}

model StockLocation {
  id        String @id @default(cuid())
  outletId  String
  name      String
  sortOrder Int    @default(0)

  outlet   Outlet             @relation(fields: [outletId], references: [id], onDelete: Cascade)
  balances InventoryBalance[]

  @@unique([outletId, name])
}

model InventoryBalance {
  id           String  @id @default(cuid())
  outletId     String
  ingredientId String
  locationId   String?
  batchId      String?
  onHand       Decimal @default(0) @db.Decimal(12, 3)
  committed    Decimal @default(0) @db.Decimal(12, 3)
  inTransit    Decimal @default(0) @db.Decimal(12, 3)

  outlet     Outlet          @relation(fields: [outletId], references: [id], onDelete: Cascade)
  ingredient Ingredient      @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  location   StockLocation?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  batch      InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([outletId, ingredientId, locationId, batchId])
}

model StockCommitment {
  id           String           @id @default(cuid())
  outletId     String
  ingredientId String
  orderId      String
  orderItemId  String
  quantity     Decimal          @db.Decimal(12, 3)
  status       CommitmentStatus @default(committed)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  outlet     Outlet     @relation(fields: [outletId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([orderItemId, ingredientId])
  @@index([outletId, orderId])
}

model InventoryBatch {
  id              String      @id @default(cuid())
  outletId        String
  ingredientId    String
  batchNumber     String
  supplierId      String?
  purchaseInvoice String?
  manufacturingDate DateTime?
  receivedDate    DateTime    @default(now())
  expiryDate      DateTime?
  receivedQty     Decimal     @db.Decimal(12, 3)
  remainingQty    Decimal     @db.Decimal(12, 3)
  unitCost        Decimal     @db.Decimal(10, 2)
  status          BatchStatus @default(available)
  storageLocation String?

  outlet     Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  ingredient Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  supplier   Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  balances   InventoryBalance[]
  ledgerEntries StockLedger[]
  goodsReceiptLines GoodsReceiptLine[]
  wastageEntries WastageEntry[]

  @@unique([outletId, ingredientId, batchNumber])
}

model SupplierItem {
  id              String  @id @default(cuid())
  supplierId      String
  ingredientId    String
  supplierItemName String?
  supplierItemCode String?
  purchaseUnit    String?
  latestPrice     Decimal @default(0) @db.Decimal(10, 2)
  minOrderQty     Decimal @default(0) @db.Decimal(12, 3)
  preferredRank   Int     @default(0)

  supplier   Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([supplierId, ingredientId])
}

model PurchaseRequest {
  id          String          @id @default(cuid())
  outletId    String
  requestNumber String
  status      PORequestStatus @default(draft)
  requiredBy  DateTime?
  requesterId String?
  reason      String?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  outlet Outlet                @relation(fields: [outletId], references: [id], onDelete: Cascade)
  lines  PurchaseRequestLine[]

  @@unique([outletId, requestNumber])
}

model PurchaseRequestLine {
  id                String  @id @default(cuid())
  purchaseRequestId String
  ingredientId      String
  currentStock      Decimal @default(0) @db.Decimal(12, 3)
  suggestedQty      Decimal @default(0) @db.Decimal(12, 3)
  requestedQty      Decimal @default(0) @db.Decimal(12, 3)

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
}

model GoodsReceipt {
  id              String   @id @default(cuid())
  outletId        String
  grnNumber       String
  purchaseOrderId String?
  supplierId      String?
  receivedAt      DateTime @default(now())
  receivedById    String?
  notes           String?
  qualityResult   String?
  invoiceAttachment String?

  outlet        Outlet             @relation(fields: [outletId], references: [id], onDelete: Cascade)
  supplier      Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  lines         GoodsReceiptLine[]
  invoices      PurchaseInvoice[]

  @@unique([outletId, grnNumber])
}

model GoodsReceiptLine {
  id             String  @id @default(cuid())
  goodsReceiptId String
  ingredientId   String
  receivedQty    Decimal @db.Decimal(12, 3)
  rejectedQty    Decimal @default(0) @db.Decimal(12, 3)
  freeQty        Decimal @default(0) @db.Decimal(12, 3)
  unitPrice      Decimal @db.Decimal(10, 2)
  purchaseUnit   String?
  batchId        String?
  damageNotes    String?

  goodsReceipt GoodsReceipt    @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  ingredient   Ingredient      @relation(fields: [ingredientId], references: [id])
  batch        InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
}

model PurchaseInvoice {
  id               String   @id @default(cuid())
  outletId         String
  supplierId       String
  goodsReceiptId   String?
  invoiceNumber    String
  invoiceDate      DateTime
  gstin            String?
  taxableValue     Decimal  @default(0) @db.Decimal(12, 2)
  cgst             Decimal  @default(0) @db.Decimal(12, 2)
  sgst             Decimal  @default(0) @db.Decimal(12, 2)
  igst             Decimal  @default(0) @db.Decimal(12, 2)
  discount         Decimal  @default(0) @db.Decimal(12, 2)
  freight          Decimal  @default(0) @db.Decimal(12, 2)
  rounding         Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal  @default(0) @db.Decimal(12, 2)
  paymentStatus    String   @default("unpaid")
  attachmentUrl    String?
  createdAt        DateTime @default(now())

  outlet       Outlet        @relation(fields: [outletId], references: [id], onDelete: Cascade)
  supplier     Supplier      @relation(fields: [supplierId], references: [id])
  goodsReceipt GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
}

model PurchaseReturn {
  id           String   @id @default(cuid())
  outletId     String
  supplierId   String
  returnNumber String
  reason       String
  notes        String?
  createdAt    DateTime @default(now())

  outlet   Outlet               @relation(fields: [outletId], references: [id], onDelete: Cascade)
  supplier Supplier             @relation(fields: [supplierId], references: [id])
  lines    PurchaseReturnLine[]

  @@unique([outletId, returnNumber])
}

model PurchaseReturnLine {
  id               String  @id @default(cuid())
  purchaseReturnId String
  ingredientId     String
  quantity         Decimal @db.Decimal(12, 3)
  unitCost         Decimal @db.Decimal(10, 2)

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  ingredient     Ingredient     @relation(fields: [ingredientId], references: [id])
}

model StockCount {
  id           String      @id @default(cuid())
  outletId     String
  countNumber  String
  countType    CountType
  status       CountStatus @default(draft)
  countDate    DateTime    @default(now())
  locationName String?
  isBlind      Boolean     @default(false)
  countedById  String?
  verifiedById String?
  approvedById String?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  outlet Outlet          @relation(fields: [outletId], references: [id], onDelete: Cascade)
  lines  StockCountLine[]

  @@unique([outletId, countNumber])
}

model StockCountLine {
  id             String  @id @default(cuid())
  stockCountId   String
  ingredientId   String
  expectedStock  Decimal @db.Decimal(12, 3)
  physicalStock  Decimal @default(0) @db.Decimal(12, 3)
  variance       Decimal @default(0) @db.Decimal(12, 3)
  varianceValue  Decimal @default(0) @db.Decimal(12, 2)
  reason         String?

  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
}

model WastageEntry {
  id           String          @id @default(cuid())
  outletId     String
  ingredientId String
  batchId      String?
  quantity     Decimal         @db.Decimal(12, 3)
  unit         String
  costImpact   Decimal         @default(0) @db.Decimal(12, 2)
  category     WastageCategory @default(unexplained)
  reason       String?
  location     String?
  orderId      String?
  photoUrl     String?
  recordedById String?
  approvedById String?
  notes        String?
  createdAt    DateTime        @default(now())

  outlet     Outlet          @relation(fields: [outletId], references: [id], onDelete: Cascade)
  ingredient Ingredient      @relation(fields: [ingredientId], references: [id])
  batch      InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
}

model StockTransferLine {
  id           String  @id @default(cuid())
  transferId   String
  ingredientId String
  requestedQty Decimal @db.Decimal(12, 3)
  dispatchedQty Decimal @default(0) @db.Decimal(12, 3)
  receivedQty  Decimal @default(0) @db.Decimal(12, 3)
  batchId      String?
  varianceNotes String?

  transfer   CentralKitchenTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  ingredient Ingredient             @relation(fields: [ingredientId], references: [id])
}

model ProductionOrder {
  id              String           @id @default(cuid())
  outletId        String
  orderNumber     String
  outputItemId    String
  plannedOutput   Decimal          @db.Decimal(12, 3)
  actualOutput    Decimal?         @db.Decimal(12, 3)
  productionLoss  Decimal?         @db.Decimal(12, 3)
  status          ProductionStatus @default(planned)
  plannedDate     DateTime?
  completedAt     DateTime?
  assignedToId    String?
  batchNumber     String?
  expiryDate      DateTime?
  costPerUnit     Decimal?         @db.Decimal(10, 2)
  qualityStatus   String?
  notes           String?
  createdAt       DateTime         @default(now())

  outlet     Outlet            @relation(fields: [outletId], references: [id], onDelete: Cascade)
  outputItem Ingredient        @relation("ProductionOutput", fields: [outputItemId], references: [id])
  inputs     ProductionInput[]
}

model ProductionInput {
  id                String  @id @default(cuid())
  productionOrderId String
  ingredientId      String
  plannedQty        Decimal @db.Decimal(12, 3)
  actualQty         Decimal @default(0) @db.Decimal(12, 3)

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  ingredient      Ingredient      @relation(fields: [ingredientId], references: [id])
}

model InventoryAlert {
  id           String    @id @default(cuid())
  outletId     String
  ingredientId String?
  alertType    AlertType
  message      String
  metadata     Json      @default("{}")
  isRead       Boolean   @default(false)
  createdAt    DateTime  @default(now())

  outlet     Outlet      @relation(fields: [outletId], references: [id], onDelete: Cascade)
  ingredient Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  @@index([outletId, isRead])
}

model RecipeVersion {
  id          String   @id @default(cuid())
  recipeId    String
  version     Int
  effectiveFrom DateTime @default(now())
  effectiveTo   DateTime?
  yieldQty    Int      @default(1)
  instructions String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, version])
}

// ─── Integrations & Sync ─────────────────────────────────────────────────────

model IntegrationCredential {
  id        String          @id @default(cuid())
  outletId  String
  type      IntegrationType
  config    Json            @default("{}")
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([outletId, type])
}

model SyncEvent {
  id          String          @id @default(cuid())
  outletId    String
  userId      String?
  entityType  String
  entityId    String
  action      String
  payload     Json
  status      SyncEventStatus @default(pending)
  clientId    String?
  syncedAt    DateTime?
  createdAt   DateTime        @default(now())

  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([outletId, status])
  @@index([clientId, status])
}

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String
  userId         String?
  outletId       String?
  action         AuditAction
  entityType     String?
  entityId       String?
  metadata       Json        @default("{}")
  ipAddress      String?
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

// ─── R2: Device Health & Diagnostics ─────────────────────────────────────────

model DeviceHealth {
  id             String   @id @default(cuid())
  deviceId       String   @unique
  outletId       String
  terminalId     String?
  role           String
  deviceType     String
  name           String
  lanAddress     String?
  status         String   @default("offline")
  syncBacklog    Int      @default(0)
  hubConnected   Boolean  @default(false)
  cloudConnected Boolean  @default(false)
  lastSeenAt     DateTime?
  lastSyncAt     DateTime?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([outletId, status])
}

// ─── R2: Profitability ───────────────────────────────────────────────────────

model OrderMarginSnapshot {
  id                    String   @id @default(cuid())
  orderId               String   @unique
  outletId              String
  revenue               Decimal  @db.Decimal(12, 2)
  ingredientCost        Decimal  @db.Decimal(12, 2)
  packagingCost         Decimal  @db.Decimal(12, 2)
  aggregatorCommission  Decimal  @default(0) @db.Decimal(12, 2)
  discountAmount        Decimal  @default(0) @db.Decimal(12, 2)
  paymentFee            Decimal  @default(0) @db.Decimal(12, 2)
  laborAllocation       Decimal  @default(0) @db.Decimal(12, 2)
  wastageAllocation     Decimal  @default(0) @db.Decimal(12, 2)
  contributionMargin    Decimal  @db.Decimal(12, 2)
  marginPercent         Decimal  @db.Decimal(5, 2)
