# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json turbo.json ./
COPY apps ./apps
COPY packages ./packages
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/* \
  && npm ci

FROM deps AS builder
WORKDIR /app
ARG APP_NAME=@kaana/kds-web
ARG NEXT_PUBLIC_API_URL=http://localhost:4000/api
ARG NEXT_PUBLIC_WS_URL=http://localhost:4000/events
ARG NEXT_PUBLIC_HUB_URL=http://localhost:4100
ARG NEXT_PUBLIC_OPERATIONS_WEB_URL=http://localhost:3010
ARG NEXT_PUBLIC_POS_WEB_URL=http://localhost:3001
ARG NEXT_PUBLIC_KDS_WEB_URL=http://localhost:3002
ARG NEXT_PUBLIC_CAPTAIN_WEB_URL=http://localhost:3003
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL \
    NEXT_PUBLIC_HUB_URL=$NEXT_PUBLIC_HUB_URL \
    NEXT_PUBLIC_OPERATIONS_WEB_URL=$NEXT_PUBLIC_OPERATIONS_WEB_URL \
    NEXT_PUBLIC_POS_WEB_URL=$NEXT_PUBLIC_POS_WEB_URL \
    NEXT_PUBLIC_KDS_WEB_URL=$NEXT_PUBLIC_KDS_WEB_URL \
    NEXT_PUBLIC_CAPTAIN_WEB_URL=$NEXT_PUBLIC_CAPTAIN_WEB_URL \
    NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production
RUN npx turbo run build --filter=${APP_NAME}

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ARG APP_DIR=apps/kds-web
ENV NODE_ENV=production \
    PORT=8080 \
    HOSTNAME=0.0.0.0 \
    APP_DIR=${APP_DIR} \
    NEXT_TELEMETRY_DISABLED=1
RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nextjs
COPY --from=builder --chown=nextjs:nodejs /app/${APP_DIR}/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/${APP_DIR}/.next/static ./${APP_DIR}/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/${APP_DIR}/public ./${APP_DIR}/public
USER nextjs
EXPOSE 8080
CMD ["sh", "-c", "node ${APP_DIR}/server.js"]
